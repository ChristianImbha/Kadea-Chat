
@layouts.app({ title: 'Mon profil' })
  @page()
    <div class="empty">
      <h1>Mon profil</h1>
      <p>Consultez et modifiez vos informations personnelles.</p>

      @if(flashMessages.has('success'))
        <p>{{ flashMessages.get('success') }}</p>
      @end

      @if(flashMessages.has('error'))
        <p>{{ flashMessages.get('error') }}</p>
      @end

      <form method="POST" action="/profile">
        {{ csrfField() }}

        <div>
          <label for="fullName">Nom complet</label>
          <input
            type="text"
            id="fullName"
            name="fullName"
            value="{{ user.fullName }}"
            maxlength="254"
            required
          >
        </div>

        <div>
          <label for="email">Adresse e-mail</label>
          <input
            type="email"
            id="email"
            value="{{ user.email }}"
            disabled
          >
          <p>L'adresse e-mail ne peut pas être modifiée ici.</p>
        </div>

        <button type="submit">Enregistrer les modifications</button>
      </form>

      <p><a href="/dashboard">Retour au dashboard</a></p>
    </div>
  @end
@end
