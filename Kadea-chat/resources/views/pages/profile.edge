{{-- Layout principal de l'application avec le titre de la page --}}
@layouts.app({ title: 'Mon profil' })

  {{-- Contenu principal de la page --}}
  @page()
    <div class="empty profile-page">

      {{-- Titre et introduction --}}
      <h1>Mon profil</h1>
      <p>Consultez et modifiez vos informations personnelles.</p>

      {{-- Afficher un message de succes apras une operation --}}
      @if(flashMessages.has('success'))
        <p>{{ flashMessages.get('success') }}</p>
      @end

      {{-- Afficher un message d'erreur si une operation a echoue --}}
      @if(flashMessages.has('error'))
        <p>{{ flashMessages.get('error') }}</p>
      @end

      {{-- SECTION 1 : MODIFICATION DU PROFIL --}}

      <hr>

      <h2>Mes informations personnelles</h2>

      {{-- Formulaire de modification du profil et d'envoi de la photo --}}
      <form method="POST" action="/profile" enctype="multipart/form-data">

        {{-- Jeton CSRF pour proteger le formulaire contre les requettes falsifiees --}}
        {{ csrfField() }}

            {{-- Photo de profil : affichage de la photo actuelle si elle existe --}}

        {{-- Photo de profil --}}
        <div class="profile-avatar-section">
          <label for="avatar" class="profile-avatar-section__title">
            Photo de profil
          </label>

          @if(user.avatarPath)
            <div class="profile-avatar">
              <img
                src="{{ user.avatarPath }}"
                alt="Photo de profil"
                class="profile-avatar__image"
              >
            </div>
          @end


          <label for="avatar" class="profile-file__button">
            Choisir une photo
          </label>
          <input
            type="file"
            id="avatar"
            name="avatar"
            class="profile-file__input"
            accept="image/jpeg,image/png,image/webp"
          >
          <span id="avatar-file-name" class="profile-file__name">
           Aucune photo sélectionnée
          </span>

        </div>
        {{-- Champ du nom complet --}}
        <div>
          <label for="fullName">Nom complet</label>
          <input
            type="text"
            id="fullName"
            name="fullName"
            value="{{ user.fullName }}"
            maxlength="254"
            autocomplete="name"
            required
          >
        </div>

        {{-- Adresse e-mail affiche en lecture seule --}}
        <div>
          <label for="email">Adresse e-mail</label>
          <input
            type="email"
            id="email"
            value="{{ user.email }}"
            disabled
          >

          <p>L'adresse e-mail ne peut pas etre modifiée ici.</p>
        </div>

        {{-- Bouton de sauvegarde des informations personnelles --}}
        <button type="submit">
          Enregistrer les modifications
        </button>

      </form>


      {{-- SECTION 2 : CHANGEMENT DU MOT DE PASSE    --}}


      <hr>

      <h2>Changer mon mot de passe</h2>

      <p>
        Pour votre sécurité, saisissez votre mot de passe actuel,
      </p>

      {{-- Envoyer les donnÃ©es Ã  la mÃ©thode updatePassword du contrÃ´leur --}}
      <form method="POST" action="/profile/password">

        {{-- Jeton CSRF de sÃ©curitÃ© --}}
        {{ csrfField() }}

        {{-- VÃ©rifier l'identitÃ© avec le mot de passe actuel --}}
        <div>
          <label for="currentPassword">Mot de passe actuel</label>
          <input
            type="password"
            id="currentPassword"
            name="currentPassword"
            autocomplete="current-password"
            required
          >
        </div>

        {{-- Saisir le nouveau mot de passe --}}
        <div>
          <label for="password">Nouveau mot de passe</label>
          <input
            type="password"
            id="password"
            name="password"
            minlength="8"
            maxlength="32"
            autocomplete="new-password"
            required
          >
        </div>

        {{-- VÃ©rifier que le nouveau mot de passe est correctement confirmÃ© --}}
        <div>
          <label for="passwordConfirmation">
            Confirmer le nouveau mot de passe
          </label>

          <input
            type="password"
            id="passwordConfirmation"
            name="passwordConfirmation"
            minlength="8"
            maxlength="32"
            autocomplete="new-password"
            required
          >
        </div>

        {{-- Bouton de validation du changement de mot de passe --}}
        <button type="submit">
          Modifier mon mot de passe
        </button>

      </form>


    <script>
      const avatarInput = document.getElementById('avatar');
      const avatarFileName = document.getElementById('avatar-file-name');

      avatarInput?.addEventListener('change', () => {
        avatarFileName.textContent = avatarInput.files?.[0]?.name
          || 'Aucune photo selectionnée';
      });
    </script>


      {{-- SECTION 3 : NAVIGATION  --}}


      {{-- Permet de retourner au tableau de bord --}}
      <p>
        <a href="/dashboard">Retour au dashboard</a>
      </p>

    </div>
  @end

@end
