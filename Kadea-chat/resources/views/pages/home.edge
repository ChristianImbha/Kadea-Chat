@layouts.marketing()

<header class="landing-nav">
  <a href="/" class="landing-brand" aria-label="Kadea Chat, accueil">
    <span class="landing-brand-mark">K</span>
    <span>Kadea <strong>Chat</strong></span>
  </a>

  <div class="landing-nav-actions">
    <a href="/login" class="landing-login">Se connecter</a>
    <a href="/signup">Créer un compte</a>
  </div>
</header>

<main class="landing-page">
  <section class="landing-hero">
    <div class="landing-hero-copy">
      <h1>
        Kadea Chat
        <span>Restez en contact.</span>
      </h1>

      <p class="landing-description">
        Discutez avec vos contacts, en privé ou en groupe.
      </p>

      <div class="landing-hero-actions">
        <a href="/signup" class="landing-button landing-button-small">
          Créer un compte
        </a>

        <a href="/login" class="landing-secondary-link">
          Se connecter
        </a>
      </div>
    </div>
  </section>
</main>

<footer class="landing-footer">
  <a href="/" class="landing-brand" aria-label="Kadea Chat, accueil">
    <span class="landing-brand-mark">K</span>
    <span>Kadea <strong>Chat</strong></span>
  </a>
 <hr>
  <small>© 2026 Kadea Chat, tout droit reservé</small>
</footer>

@end