@layouts.app({ title: 'Tableau de bord' })
  @page()
    <section class="dashboard-page">
      <header class="dashboard-intro">
        <div>
          <span class="dashboard-kicker">VOTRE ESPACE KADEA</span>
          <h1>Bonjour, {{ auth.user.fullName }}</h1>
          <p>Retrouvez vos échanges et reprenez la conversation.</p>
        </div>
        <a class="dashboard-profile-link" href="/profile">
          @svg('lucide:user-round', { width: 17, height: 17 })
          Mon profil
        </a>
      </header>

      <div class="dashboard-grid">
        {{-- Liste des conversations existantes et aperçu du dernier message. --}}
        <section class="dashboard-section dashboard-section--conversations">
          <div class="dashboard-section__heading">
            <div>
              <span class="dashboard-kicker">VOS ÉCHANGES</span>
              <h2>Conversations</h2>
            </div>
            <span class="dashboard-count">{{ conversations.length }}</span>
          </div>

          @if(conversations.length > 0)
            <div class="dashboard-conversations">
              @each(conversation in conversations)
                <a class="dashboard-conversation" href="/conversations/{{ conversation.id }}">
                  <span class="dashboard-conversation__icon">
                    @if(conversation.type === 'group')
                      @svg('lucide:users-round', { width: 19, height: 19 })
                    @else
                      @svg('lucide:message-circle', { width: 19, height: 19 })
                    @end
                  </span>
                  <span class="dashboard-conversation__content">
                    <span class="dashboard-conversation__title">
                      <strong>
                        @if(conversation.type === 'group')
                          {{ conversation.name }}
                        @else
                          @each(member in conversation.members)
                            @if(member.userId !== auth.user.id)
                              {{ member.user.fullName }}
                            @end
                          @end
                        @end
                      </strong>
                      @if(unreadCounts[conversation.id] > 0)
                        <span class="dashboard-unread">{{ unreadCounts[conversation.id] }}</span>
                      @end
                    </span>
                    <span class="dashboard-conversation__preview">
                      @if(conversation.messages.length > 0)
                        @if(conversation.messages[0].isDeleted)
                          Message supprimé
                        @else
                          {{ conversation.messages[0].content }}
                        @end
                      @else
                        Aucun message pour le moment
                      @end
                    </span>
                  </span>
                  <span class="dashboard-conversation__arrow">
                    @svg('lucide:arrow-up-right', { width: 17, height: 17 })
                  </span>
                </a>
              @end
            </div>
          @else
            <div class="dashboard-empty">
              <span class="dashboard-conversation__icon">
                @svg('lucide:messages-square', { width: 21, height: 21 })
              </span>
              <strong>Vos conversations apparaîtront ici</strong>
              <p>Créez un groupe ou démarrez un échange privé pour commencer.</p>
            </div>
          @end
        </section>

        {{-- Formulaires de création de groupe et de discussion privée. --}}
        <aside class="dashboard-section dashboard-section--new">
          <div class="dashboard-section__heading">
            <div>
              <span class="dashboard-kicker">NOUVEL ÉCHANGE</span>
              <h2>Créer une conversation</h2>
            </div>
          </div>

          {{-- Envoie le nom du groupe et les membres choisis au contrôleur. --}}
          <form class="dashboard-form" method="POST" action="/conversations/groups">
            {{ csrfField() }}
            <h3>
              @svg('lucide:users-round', { width: 18, height: 18 })
              <span>Nouveau groupe</span>
            </h3>
            <label for="group-name">Nom du groupe</label>
            <input type="text" id="group-name" name="name" maxlength="254" required placeholder="Ex. Équipe projet">
            <fieldset class="dashboard-user-list">
              <legend>Choisissez au moins deux personnes</legend>
              @each(user in users)
                <label class="dashboard-user-option">
                  <input type="checkbox" name="userIds[]" value="{{ user.id }}">
                  <span><strong>{{ user.fullName }}</strong><small>{{ user.email }}</small></span>
                </label>
              @end
            </fieldset>
            <button class="dashboard-primary-button" type="submit">
              <span>Créer le groupe</span>
              @svg('lucide:arrow-right', { width: 16, height: 16 })
            </button>
          </form>

          {{-- Filtre les utilisateurs et ouvre une conversation privée. --}}
          <div class="dashboard-private">
            <h3>
              @svg('lucide:message-circle', { width: 18, height: 18 })
              <span>Discussion privée</span>
            </h3>
            <label for="user-search">Rechercher une personne</label>
            <input type="search" id="user-search" placeholder="Nom ou e-mail…" autocomplete="off">
            @if(users.length > 0)
              <div class="dashboard-private-list">
                @each(user in users)
                  <div class="dashboard-private-user searchable-user" data-search="{{ user.fullName }} {{ user.email }}">
                    <span><strong>{{ user.fullName }}</strong><small>{{ user.email }}</small></span>
                    <form method="POST" action="/conversations">
                      {{ csrfField() }}
                      <input type="hidden" name="userId" value="{{ user.id }}">
                      <button type="submit" aria-label="Écrire à {{ user.fullName }}">
                        @svg('lucide:arrow-up-right', { width: 17, height: 17 })
                      </button>
                    </form>
                  </div>
                @end
              </div>
            @else
              <p class="dashboard-muted">Aucun autre compte n’est encore disponible.</p>
            @end
          </div>
        </aside>
      </div>
    </section>
  @end
@end