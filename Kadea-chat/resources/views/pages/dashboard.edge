
@layouts.app({ title: 'Dashboard' })
  @page()

    <div class="empty">
      <div class="empty__mark">
        @svg('lucide:layout-grid', { width: 22, height: 22 })
      </div>

      <h1>Welcome to Kadea Chat</h1>

      <p>
        You are successfully authenticated.
      </p>

      <!-- SECTION 1 : CONVERSATIONS EXISTANTES -->

      <h2>My conversations</h2>

      @if(conversations.length > 0)
        <ul>
          @each(conversation in conversations)
            <li>
              <strong>
                Conversation #{{ conversation.id }}
              </strong>

              <span>
                @each(member in conversation.members)
                  @if(member.userId !== conversation.createdBy)
                    {{ member.user.fullName }}
                  @end
                @end
              </span>
            </li>
          @end
        </ul>
      @else
        <p>You don't have any conversations yet.</p>
      @end

      <!-- SECTION 2 : DEMARRER UNE CONVERSATION -->

      <h2>Start a private conversation</h2>

      @if(users.length > 0)
        <ul>
          @each(user in users)
            <li>
              <strong>{{ user.fullName }}</strong>
              <span>{{ user.email }}</span>

              <form method="POST" action="/conversations">
                {{ csrfField() }}

                <input
                  type="hidden"
                  name="userId"
                  value="{{ user.id }}"
                >

                <button type="submit">
                  Start conversation
                </button>
              </form>
            </li>
          @end
        </ul>
      @else
        <p>No other users are registered yet.</p>
      @end

      <!-- SECTION 3 : DECONNEXION -->

      <form method="POST" action="/logout">
        {{ csrfField() }}

        <button type="submit">
          Logout
        </button>
      </form>
    </div>

  @end
@end


