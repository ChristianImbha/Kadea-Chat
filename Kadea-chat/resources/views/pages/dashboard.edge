
@layouts.app({ title: 'Dashboard' })
  @page()
    <div class="empty">
      <div class="empty__mark">
        @svg('lucide:layout-grid', { width: 22, height: 22 })
      </div>

      <h1>Welcome to Kadea Chat</h1>
      <p><a href="/profile">Mon profil</a></p>
      <p>You are successfully authenticated.</p>

      <!-- CONVERSATIONS EXISTANTES -->

          <h2>My conversations</h2>

          @if(conversations.length > 0)
            <ul>
              @each(conversation in conversations)
                <li>
                  <a href="/conversations/{{ conversation.id }}">
                    <strong>
                      @if(conversation.type === 'group')
                        {{ conversation.name }}
                      @else
                        Conversation #{{ conversation.id }}
                      @end
                    </strong>
                  </a>

                  @if(unreadCounts[conversation.id] > 0)
                    <span class="unread-badge">
                      {{ unreadCounts[conversation.id] }} non lu(s)
                    </span>
                  @end



          <p>
            Participants:
            @each(member in conversation.members)
              <span>{{ member.user.fullName }} </span>
            @end
          </p>

          @if(conversation.messages.length > 0)
            <p>
                Dernier message :
                @if(conversation.messages[0].isDeleted)
                  <em>Ce message a été supprimé.</em>
                @else
                  {{ conversation.messages[0].content }}
                @end
            </p>

            <p>
              Envoyé le :
              {{ conversation.messages[0].createdAt.toFormat('dd/LL/yyyy HH:mm') }}
            </p>
          @else
            <p>Aucun message pour le moment.</p>
          @end

                </li>
              @end
            </ul>
          @else
            <p>You don't have any conversations yet.</p>
          @end



<!-- CREER UN GROUPE -->
          <h2>Create a group</h2>

          <form method="POST" action="/conversations/groups">
            {{ csrfField() }}

            <div>
              <label for="group-name">Group name</label>
              <input
                type="text"
                id="group-name"
                name="name"
                maxlength="254"
                required
                placeholder="Enter a group name"
              >
            </div>

            <p>Select at least two participants:</p>

            @each(user in users)
              <div>
                <label>
                  <input
                    type="checkbox"
                    name="userIds[]"
                    value="{{ user.id }}"
                  >
                  {{ user.fullName }} ({{ user.email }})
                </label>
              </div>
            @end

            <button type="submit">Create group</button>
          </form>


      <!-- DEMARRER UNE CONVERSATION PRIVEE -->
      <h2>Start a private conversation</h2>

      <label for="user-search">Rechercher un utilisateur</label>
      <input
        type="search"
        id="user-search"
        placeholder="Nom ou adresse e-mail..."
        autocomplete="off"
      >

      @if(users.length > 0)
        <ul>
          @each(user in users)

          <li
            class="searchable-user"
            data-search="{{ user.fullName }} {{ user.email }}"
          >
            <strong>{{ user.fullName }}</strong>
            <p>{{ user.email }}</p>

            <form method="POST" action="/conversations">
              {{ csrfField() }}

              <input
                type="hidden"
                name="userId"
                value="{{ user.id }}"
              >

              <button type="submit">
                Start conversation
              </button>
            </form>
          </li>

          @end
        </ul>
      @else
        <p>No other users are registered yet.</p>
      @end

      <!-- DECONNEXION -->
      <form method="POST" action="/logout">
        {{ csrfField() }}
        <button type="submit">Logout</button>
      </form>
    </div>
  @end
@end



