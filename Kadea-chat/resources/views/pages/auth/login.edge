@layouts.auth()
  <h1 class="auth__title">Ravi de vous retrouver</h1>
  <p class="auth__sub">Connectez-vous pour retrouver vos conversations.</p>

  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @if (flashMessages.has('error'))
      <p class="error">{{ flashMessages.get('error') }}</p>
    @endif

    @if (flashMessages.has('success'))
      <p class="success">{{ flashMessages.get('success') }}</p>
    @endif

    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end

    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })

      <div class="auth__password-field">
        <input
          id="password"
          type="password"
          name="password"
          autocomplete="current-password"
          placeholder="••••••••"
          required
        >

        <button
            type="button"
            class="auth__password-toggle"
            aria-label="Afficher ou masquer le mot de passe"
            onclick="
              const input = document.getElementById('password');
              const show = input.type === 'password';
              input.type = show ? 'text' : 'password';
              this.innerHTML = show
                ? '<svg viewBox=&quot;0 0 24 24&quot; aria-hidden=&quot;true&quot;><path d=&quot;M3 3l18 18&quot;/><path d=&quot;M10.6 10.6a2 2 0 0 0 2.8 2.8&quot;/><path d=&quot;M9.9 5.2A11.5 11.5 0 0 1 12 5c6.4 0 10 7 10 7a15.5 15.5 0 0 1-3.1 3.8&quot;/><path d=&quot;M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10.5 10.5 0 0 0 3.1-.5&quot;/></svg>'
                : '<svg viewBox=&quot;0 0 24 24&quot; aria-hidden=&quot;true&quot;><path d=&quot;M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z&quot;/><circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;3&quot;/></svg>';
            "
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
        </button>
      </div>

      @!field.error()
    @end

    @!button({
      text: 'Se connecter',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Connexion…' : 'Se connecter'",
    })

    @link({ route: 'password_resets.create', class: 'il' })
      Mot de passe oublié ?
    @end

    <p class="auth__foot">
      Nouveau sur Kadea Chat ?
      @link({ route: 'new_account.create', class: 'il' })
        Créer un compte
      @end
    </p>
  @end
@end