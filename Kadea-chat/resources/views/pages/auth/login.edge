@layouts.auth()
  <h1 class="auth__title">Ravi de vous retrouver</h1>
  <p class="auth__sub">Connectez-vous pour retrouver vos conversations.</p>

  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @if (flashMessages.has('error'))
      <p class="error">{{ flashMessages.get('error') }}</p>
    @endif

    @if (flashMessages.has('success'))
      <p class="success">{{ flashMessages.get('success') }}</p>
    @endif

    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end

    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end

    @!button({
      text: 'Se connecter',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Connexion…' : 'Se connecter'",
    })
  @end
     @link({ route: 'password_resets.create', class: 'il' })
        Mot de passe oublié ?
     @end
  <p class="auth__foot">
        Nouveau sur Kadea Chat ?
    @link({ route: 'new_account.create', class: 'il' })
      Créer un compte
    @end
  </p>
@end
