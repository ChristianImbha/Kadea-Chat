<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  @vite(['resources/css/app.css', 'resources/js/app.js'])
  <title>Choisir un nouveau mot de passe - Kadea Chat</title>
</head>

<body>
  <main class="auth-standalone">

    <a class="brand-link auth-standalone__brand" href="/">
      <span class="brand-mark">
        @svg('lucide:messages-square', { width: 16, height: 16 })
      </span>
      <span class="brand-wordmark">kadea<span>chat</span></span>
    </a>

    <span class="dashboard-kicker">ACCÈS À VOTRE COMPTE</span>

    <h1>Choisir un nouveau mot de passe</h1>
    <p>Saisis ton nouveau mot de passe et confirme-le.</p>

    @if(flashMessages.has('error'))
      <p>{{ flashMessages.get('error') }}</p>
    @end

    <form method="POST" action="/password/reset/{{ token }}">
      {{ csrfField() }}

      <!-- Nouveau mot de passe -->
      <div class="auth__password-field">
        <label for="password">Nouveau mot de passe</label>

        <div class="auth__password-input">
          <input
            id="password"
            type="password"
            name="password"
            minlength="8"
            maxlength="32"
            autocomplete="new-password"
            required
          >

          <button
            type="button"
            class="auth__password-toggle"
            data-password-toggle="password"
            aria-label="Afficher le mot de passe"
            aria-pressed="false"
          >
            <span class="eye-open">
              @svg('lucide:eye', { width: 18, height: 18 })
            </span>
            <span class="eye-closed">
              @svg('lucide:eye-off', { width: 18, height: 18 })
            </span>
          </button>
        </div>
      </div>

      <!-- Confirmation du mot de passe -->
      <div class="auth__password-field">
        <label for="passwordConfirmation">Confirmer le mot de passe</label>

        <div class="auth__password-input">
          <input
            id="passwordConfirmation"
            type="password"
            name="passwordConfirmation"
            minlength="8"
            maxlength="32"
            autocomplete="new-password"
            required
          >

          <button
            type="button"
            class="auth__password-toggle"
            data-password-toggle="passwordConfirmation"
            aria-label="Afficher le mot de passe"
            aria-pressed="false"
          >
            <span class="eye-open">
              @svg('lucide:eye', { width: 18, height: 18 })
            </span>
            <span class="eye-closed">
              @svg('lucide:eye-off', { width: 18, height: 18 })
            </span>
          </button>
        </div>
      </div>

      <button type="submit">Réinitialiser le mot de passe</button>
    </form>

    <a class="auth-standalone__back" href="/login">
      Retour à la connexion
    </a>

  </main>

  <script>
    document.querySelectorAll('[data-password-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        const input = document.getElementById(button.dataset.passwordToggle);

        if (!input) return;

        const isVisible = input.type === 'text';

        input.type = isVisible ? 'password' : 'text';

        button.setAttribute('aria-pressed', String(!isVisible));

        button.setAttribute(
          'aria-label',
          isVisible ? 'Afficher le mot de passe' : 'Masquer le mot de passe'
        );
      });
    });
  </script>

</body>
</html>

