
<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  @vite(['resources/css/app.css', 'resources/js/app.js'])
  <title>Mot de passe oublié - Kadea Chat</title>
</head>
<body>
  <main class="auth-standalone">
    <a class="brand-link auth-standalone__brand" href="/">
  <span class="brand-mark">K</span>
  <span class="brand-wordmark">kadea<span>chat</span></span>
</a>
<span class="dashboard-kicker">ACCÈS À VOTRE COMPTE</span>
    <h1>Mot de passe oublié</h1>
    <p>Saisis ton adresse e-mail pour demander un lien de réinitialisation.</p>

    @if (flashMessages.has('success'))
      <p>{{ flashMessages.get('success') }}</p>
    @endif

    <form method="POST" action="/password/forgot">
      {{ csrfField() }}

      <label for="email">Adresse e-mail</label>
      <input
        id="email"
        type="email"
        name="email"
        required
        autocomplete="email"
      />

      <button type="submit">Envoyer</button>
    </form>

    <a class="auth-standalone__back" href="/login">Retour à la connexion</a>
  </main>
</body>
</html>
