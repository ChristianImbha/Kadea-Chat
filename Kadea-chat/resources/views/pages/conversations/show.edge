
@layouts.app({ title: 'Conversation' })
  @page()
    <div class="empty">
      <div class="empty__mark">
        @svg('lucide:message-circle', { width: 22, height: 22 })
      </div>

      <h1>
        @if(conversation.type === 'group')
          {{ conversation.name }}
        @else
          Conversation #{{ conversation.id }}
        @end
      </h1>

      <p>Type : {{ conversation.type }}</p>

      
<h2>Participants</h2>

<ul>
  @each(member in conversation.members)
    <li>
      {{ member.user.fullName }}

      @if(
        conversation.type === 'group' &&
        conversation.createdBy === currentUserId &&
        member.userId !== conversation.createdBy
      )
        <form
          method="POST"
          action="/conversations/{{ conversation.id }}/members/{{ member.userId }}/remove"
        >
          {{ csrfField() }}
          <button type="submit">Retirer du groupe</button>
        </form>
      @end
    </li>
  @end
</ul>

  @if(
    conversation.type === 'group' &&
    conversation.createdBy === currentUserId
  )
    <h2>Ajouter un membre</h2>

    <form
      method="POST"
      action="/conversations/{{ conversation.id }}/members"
    >
      {{ csrfField() }}

      <label for="userId">Choisir un utilisateur</label>
      <select id="userId" name="userId" required>
        <option value="">Sélectionner un utilisateur</option>
        @each(user in users)
          <option value="{{ user.id }}">
            {{ user.fullName }} — {{ user.email }}
          </option>
        @end
      </select>

      <button type="submit">Ajouter au groupe</button>
    </form>
  @end


      <h2>Messages</h2>

      <div
        class="chat-messages"
        id="chat-messages"
        data-conversation-id="{{ conversation.id }}"
        data-current-user-id="{{ currentUserId }}"
      >
        @if(conversation.messages.length > 0)
          @each(message in conversation.messages)
            @if(message.userId === currentUserId)
              <div class="chat-message chat-message--sent">
                <strong>Moi</strong>

                @if(message.isDeleted)
                  <p><em>Ce message a été supprimé.</em></p>
                @else
                  <p>{{ message.content }}</p>

                  <form
                    method="POST"
                    action="/conversations/{{ conversation.id }}/messages/{{ message.id }}/delete"
                  >
                    {{ csrfField() }}
                    <button type="submit">Supprimer</button>
                  </form>
                @end

                <small>
                  {{ message.createdAt.toFormat('dd/LL/yyyy HH:mm') }}
                </small>
              </div>
            @else
              <div class="chat-message chat-message--received">
                <strong>{{ message.author.fullName }}</strong>

                @if(message.isDeleted)
                  <p><em>Ce message a été supprimé.</em></p>
                @else
                  <p>{{ message.content }}</p>
                @end

                <small>
                  {{ message.createdAt.toFormat('dd/LL/yyyy HH:mm') }}
                </small>
              </div>
            @end
          @end
        @else
          <p>No messages yet. Start the conversation!</p>
        @end
      </div>

      <h3>Send a message</h3>

      <form
        id="chat-form"
        method="POST"
        action="/conversations/{{ conversation.id }}/messages"
      >
        {{ csrfField() }}

        <label for="content">Your message</label>
        <textarea
          id="content"
          name="content"
          rows="4"
          maxlength="5000"
          required
          placeholder="Write your message..."
        ></textarea>

        <button type="submit">Send message</button>
      </form>

      <p><a href="/dashboard">Back to dashboard</a></p>
    </div>
  @end
@end

