{{-- =========================================================
     1. LAYOUT PRINCIPAL
     Charge le layout général de l'application :
     navigation, styles CSS, JavaScript et déconnexion.
========================================================= --}}
@layouts.app({ title: 'Conversation' })

  {{-- Conteneur principal de la page de messagerie --}}
  <div class="chat-page">
    <div class="chat-workspace">

      {{-- =====================================================
           2. BARRE LATÉRALE : LISTE DES CONVERSATIONS
           Affiche les conversations accessibles à l'utilisateur.
      ====================================================== --}}
      <aside class="chat-sidebar">

        {{-- En-tête de la liste des conversations --}}
        <div class="chat-sidebar__header">
          <div>
            <p class="chat-eyebrow">KADEA CHAT</p>
            <h1>Messages</h1>
          </div>

          {{-- Permet de retourner au tableau de bord --}}
          <a href="/dashboard" class="chat-text-link">
            Tableau de bord
          </a>
        </div>

        {{-- Parcourt toutes les conversations chargées par le contrôleur --}}
        <div class="chat-sidebar__list">
          @each(item in conversations)

            {{-- Chaque conversation est un lien vers sa discussion --}}
            <a
              href="/conversations/{{ item.id }}"
              class="chat-conversation {{ item.id === conversation.id ? 'chat-conversation--active' : '' }}"
            >

              {{-- Icône différente selon le type de conversation --}}
              <div class="chat-avatar">
                @if(item.type === 'group')
                  @svg('lucide:users', { width: 20, height: 20 })
                @else
                  @svg('lucide:message-circle', { width: 20, height: 20 })
                @end
              </div>

              <div class="chat-conversation__body">
                <div class="chat-conversation__top">

                  {{-- Affiche le nom du groupe ou celui de l'autre participant --}}
                  <strong>
                    @if(item.type === 'group')
                      {{ item.name }}
                    @else
                      @each(member in item.members)
                        @if(member.userId !== currentUserId)
                          {{ member.user.fullName }}
                        @end
                      @end
                    @end
                  </strong>

                  {{-- Affiche le nombre de messages non lus si nécessaire --}}
                  @if(unreadCounts[item.id] && unreadCounts[item.id] > 0)
                    <span class="unread-badge">
                      {{ unreadCounts[item.id] }}
                    </span>
                  @end
                </div>

                {{-- Affiche un aperçu du dernier message de la conversation --}}
                <p>
                  @if(item.messages.length > 0)
                    {{ item.messages[0].isDeleted ? 'Message supprimé' : item.messages[0].content }}
                  @else
                    Aucun message pour le moment
                  @end
                </p>
              </div>
            </a>
          @end
        </div>
      </aside>

      {{-- =====================================================
           3. ZONE PRINCIPALE DE DISCUSSION
           Contient l'en-tête, les outils du groupe,
           les messages et le formulaire d'envoi.
      ====================================================== --}}
      <main class="chat-main">

        {{-- En-tête de la conversation actuellement ouverte --}}
        <header class="chat-header">
          <div class="chat-avatar chat-avatar--large">

            {{-- Adapte l'icône au type de conversation --}}
            @if(conversation.type === 'group')
              @svg('lucide:users', { width: 22, height: 22 })
            @else
              @svg('lucide:message-circle', { width: 22, height: 22 })
            @end
          </div>

          <div class="chat-header__info">

            {{-- Affiche le nom du groupe ou celui de l'interlocuteur --}}
            <h2>
              @if(conversation.type === 'group')
                {{ conversation.name }}
              @else
                @each(member in conversation.members)
                  @if(member.userId !== currentUserId)
                    {{ member.user.fullName }}
                  @end
                @end
              @end
            </h2>

            {{-- Indique le type de conversation et le nombre de membres --}}
            <p>
              @if(conversation.type === 'group')
                Groupe · {{ conversation.members.length }} membre(s)
              @else
                Conversation privée
              @end
            </p>
          </div>

          {{-- Retour rapide au tableau de bord --}}
          <a href="/dashboard" class="chat-back-link">
            @svg('lucide:arrow-left', { width: 16, height: 16 })
            Retour
          </a>
        </header>

        {{-- ===================================================
             4. GESTION DES MEMBRES D'UN GROUPE
             Cette section est affichée uniquement pour les groupes.
        ==================================================== --}}
        @if(conversation.type === 'group')

          {{-- details permet d'afficher ou de masquer les outils du groupe --}}
          <details class="chat-group-tools">
            <summary>
              @svg('lucide:users', { width: 16, height: 16 })
              Membres du groupe
            </summary>

            <div class="chat-group-tools__content">

              {{-- Liste des participants au groupe --}}
              <h3>Participants</h3>
              <ul class="chat-member-list">
                @each(member in conversation.members)
                  <li>
                    <span>{{ member.user.fullName }}</span>

                    {{-- Seul le créateur du groupe peut retirer les autres membres.
                         Le créateur ne peut pas se retirer lui-même ici. --}}
                    @if(conversation.createdBy === currentUserId && member.userId !== conversation.createdBy)
                      <form
                        method="POST"
                        action="/conversations/{{ conversation.id }}/members/{{ member.userId }}/remove"
                      >
                        {{ csrfField() }}
                        <button type="submit" class="chat-small-button">
                          Retirer
                        </button>
                      </form>
                    @end
                  </li>
                @end
              </ul>

              {{-- Le créateur peut ajouter un utilisateur au groupe --}}
              @if(conversation.createdBy === currentUserId)
                <h3>Ajouter un membre</h3>

                <form
                  method="POST"
                  action="/conversations/{{ conversation.id }}/members"
                  class="chat-add-member"
                >
                  {{ csrfField() }}

                  {{-- La liste des utilisateurs disponibles est fournie par le contrôleur --}}
                  <select id="userId" name="userId" required>
                    <option value="">Choisir un utilisateur</option>
                    @each(user in users)
                      <option value="{{ user.id }}">
                        {{ user.fullName }} — {{ user.email }}
                      </option>
                    @end
                  </select>

                  <button type="submit">Ajouter</button>
                </form>
              @end
            </div>
          </details>
        @end

        {{-- ===================================================
             5. HISTORIQUE DES MESSAGES
             Affiche les messages de la conversation ouverte.
             Les identifiants data-* sont utilisés par app.js
             pour la réception et l'envoi en temps réel.
        ==================================================== --}}
        <section
          class="chat-messages"
          id="chat-messages"
          data-conversation-id="{{ conversation.id }}"
          data-current-user-id="{{ currentUserId }}"
          aria-label="Messages de la conversation"
        >

          {{-- Vérifie si la conversation contient des messages --}}
          @if(conversation.messages.length > 0)

            {{-- Parcourt les messages chargés par le contrôleur --}}
            @each(message in conversation.messages)

              {{-- Distingue visuellement les messages envoyés et reçus --}}
              <article class="chat-message {{ message.userId === currentUserId ? 'chat-message--sent' : 'chat-message--received' }}">

                {{-- Affiche le nom de l'expéditeur --}}
                @if(message.userId !== currentUserId)
                  <strong>{{ message.author.fullName }}</strong>
                @else
                  <strong>Moi</strong>
                @end

                {{-- Un message supprimé est remplacé par un texte explicatif --}}
                @if(message.isDeleted)
                  <p class="chat-message__deleted">
                    @svg('lucide:ban', { width: 14, height: 14 })
                    Ce message a été supprimé.
                  </p>
                @else

                  {{-- Affiche le contenu du message --}}
                  <p>{{ message.content }}</p>

                  {{-- Seul l'auteur voit le bouton de suppression.
                       Le contrôleur doit aussi vérifier cette autorisation. --}}
                  @if(message.userId === currentUserId)
                    <form
                      method="POST"
                      action="/conversations/{{ conversation.id }}/messages/{{ message.id }}/delete"
                    >
                      {{ csrfField() }}
                      <button type="submit" class="chat-delete-button">
                        Supprimer
                      </button>
                    </form>
                  @end
                @end

                {{-- Affiche la date et l'heure d'envoi --}}
                <small>
                  {{ message.createdAt.toFormat('dd/LL/yyyy HH:mm') }}
                </small>
              </article>
            @end

          @else

            {{-- État vide affiché lorsqu'aucun message n'existe --}}
            <div class="chat-empty-state">
              <div class="chat-empty-state__icon">
                @svg('lucide:messages-square', { width: 28, height: 28 })
              </div>
              <h3>Votre conversation commence ici</h3>
              <p>
                Envoyez votre premier message pour lancer la discussion.
              </p>
            </div>
          @end
        </section>

        {{-- ===================================================
             6. FORMULAIRE D'ENVOI DES MESSAGES
             Le formulaire est identifié par chat-form.
             app.js s'appuie sur cet identifiant pour le temps réel.
        ==================================================== --}}
        <form
          id="chat-form"
          class="chat-composer"
          method="POST"
          action="/conversations/{{ conversation.id }}/messages"
        >
          {{-- Protection CSRF contre certaines requêtes non autorisées --}}
          {{ csrfField() }}

          <label for="content">Votre message</label>

          <div class="chat-composer__row">

            {{-- Champ de saisie : obligatoire, limité à 5 000 caractères --}}
            <textarea
              id="content"
              name="content"
              rows="2"
              maxlength="5000"
              required
              placeholder="Écrivez votre message..."
              aria-label="Votre message"
            ></textarea>

            {{-- Bouton qui déclenche l'envoi du message --}}
            <button type="submit" class="chat-send-button">
              @svg('lucide:send', { width: 17, height: 17 })
              <span>Envoyer</span>
            </button>
          </div>

          {{-- Indication destinée à l'utilisateur --}}
          <p class="chat-composer__hint">
            Entrée pour envoyer · Maximum 5 000 caractères
          </p>
        </form>

      </main>
    </div>
  </div>
@end
```
