<!DOCTYPE html>
<html
  lang="fr"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'dark',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>Kadea Chat — Votre messagerie</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="auth">
      <div class="auth__form-col">
        @!logo({ size: 28 })
        <div class="auth__form-wrap">{{{ await $slots.main() }}}</div>
        <div style="height: 20px;"></div>
      </div>

      <aside class="auth__aside">
        <div class="auth__aside-top">
        @!themeToggle({ defaultTheme: 'dark' })
        </div>

        <div class="auth__brand-panel">
          <span class="auth__brand-kicker">KADEA CHAT · MESSAGERIE PRIVÉE</span>
          <p class="auth__quote">Vos conversations, simplement. En privé, en groupe, à votre rythme.</p>
          <p class="auth__brand-note">Une messagerie claire pour garder le fil de ce qui compte.</p>
        </div>
      </aside>
    </div>
    @include('partials/flash_alerts')
    
</html>
